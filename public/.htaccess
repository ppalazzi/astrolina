# Hosting Apache (DonWeb): servir index.html para las rutas de la SPA
# (/quien-soy, /viajes-fotograficos, ...) y dejar pasar los archivos reales.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
